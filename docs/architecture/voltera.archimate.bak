<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Voltera" id="id-7a0cf9f79d5749aa9dbb8776af5963e3" version="5.0.0">
  <folder name="Strategy" id="id-adc0ffc6ef964f02bb3f8791ee9c005a" type="strategy"/>
  <folder name="Business" id="id-df1645ff000945c2aa9eb84757f0cd19" type="business"/>
  <folder name="Application" id="id-21ff4372cdb645c08942ff6e5fbbe00f" type="application"/>
  <folder name="Technology &amp; Physical" id="id-56fa6aad37fa48b3a619edb3e731e597" type="technology"/>
  <folder name="Motivation" id="id-d4acdd5c822e437baf185df0215fed11" type="motivation">
    <folder name="Stakeholders" id="id-d5907a63668646818f1c73452347c39c">
      <folder name="Internos" id="id-b547883f48fe43c4af1e60eed59281f7">
        <element xsi:type="archimate:Stakeholder" name="CEO / Junta directiva" id="id-b7bfc359241a408ebc3946bc44ccd8c9">
          <documentation>Crecimiento, time-to-market, costo por medidor conectado y continuidad del negocio.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="CTO / Arquitectura" id="id-1a29dd258ec64c019eedbf043f8fc39d">
          <documentation>Sostenibilidad tecnica, evolvabilidad y control del costo de la nube y de los datos.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Mesa de energia (trading)" id="id-ee2e043427b24b1b9eec271bc04214e1">
          <documentation>Precision y oportunidad de los precios, del pronostico y de la liquidacion del mercado.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Producto y crecimiento" id="id-ef80f267100243cda4ab9161cba54826">
          <documentation>Rapidez para lanzar tarifas y productos; experiencia en tiempo real del prosumidor.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Operaciones de red y campo" id="id-e3042509e3d94b97ad99082b657b704c">
          <documentation>Disponibilidad de la telemetria, deteccion de fallas y gestion de dispositivos.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Seguridad de la informacion (CISO)" id="id-19b38d9170b84d2f9d3a050580ea94a9">
          <documentation>Infraestructura critica: integridad de los comandos, identidad de dispositivos, superficie de ataque.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Cumplimiento y regulacion" id="id-9cf8b936fbbc425d9eed556129048408">
          <documentation>Reglas de la CREG, reportes al mercado, habeas data y proteccion del dato de consumo.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Finanzas (CFO)" id="id-8b698cae5e10408ea727459e61f15da0">
          <documentation>Costo total de propiedad, exactitud de la facturacion y previsibilidad del gasto.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Equipos de desarrollo (SRE/Dev)" id="id-b7f36b325750441caf7fc5b3245b641e">
          <documentation>Autonomia, velocidad de despliegue, observabilidad y carga cognitiva.</documentation>
        </element>
      </folder>
      <folder name="Externos" id="id-e3ebd06f554147c6af52aa33491efb58">
        <element xsi:type="archimate:Stakeholder" name="Prosumidores y hogares" id="id-7d6ec5aabd46423fa847f26c09718496">
          <documentation>Producen, consumen y venden energia; esperan visibilidad en tiempo real y transparencia.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Comunidades energeticas" id="id-53a4b5131fe14281b5211707f8f71057">
          <documentation>Se asocian para generar y compartir energia con reglas de reparto propias.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Empresas y grandes consumidores" id="id-d63b24f53ff14e419e8518d3af475512">
          <documentation>Compran energia y certificados de origen; exigen trazabilidad y disponibilidad.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Operador de red / distribuidora" id="id-e0f169a795db4261be2e254ca29ad1e4">
          <documentation>Opera la red fisica; aporta topologia, cortes y calidad del servicio.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Operador del mercado mayorista" id="id-c3c0f5d532d34f87a1a6f001c22e8ff2">
          <documentation>Define precios y despacho; impone ventanas de tiempo estrictas de liquidacion.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Regulador (CREG) y vigilancia" id="id-c1865ed8d837458d9e02aa30bf9443f3">
          <documentation>Fija las reglas de AMI, generacion distribuida y comunidades energeticas.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Fabricantes de medidores y dispositivos" id="id-63d42489cd354992bb943b3c21b65bfa">
          <documentation>Proveen medidores, inversores, baterias y cargadores (protocolos heterogeneos).</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Agregadores de flexibilidad" id="id-bf7198d236c249b2983faaa183434fe1">
          <documentation>Consumen la capacidad de respuesta a la demanda de Voltera y la llevan al mercado.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Certificadoras de origen renovable" id="id-866d3b7cd89e4b6db23ef14a287aba4a">
          <documentation>Validan y reconocen los certificados de energia limpia.</documentation>
        </element>
        <element xsi:type="archimate:Stakeholder" name="Pasarelas de pago y bancos" id="id-751ce1c72f36454d878d4a360bd858d6">
          <documentation>Recaudo de facturas y pago de excedentes a los prosumidores.</documentation>
        </element>
      </folder>
    </folder>
    <folder name="Drivers" id="id-c92e003a3f20478e8256e3a4f7d94af5">
      <element xsi:type="archimate:Driver" name="AMI / medicion avanzada" id="id-b416713a1fd04215a0c804c52d2a8404">
        <documentation>Despliegue de medidores inteligentes con comunicacion bidireccional (CREG 101-001 de 2022).</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Generacion distribuida (prosumidor)" id="id-9fa839f8d8404f85bd5059b3bd54a403">
        <documentation>El usuario produce, almacena y entrega excedentes a la red.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Apertura regulatoria a comunidades energeticas" id="id-0459e4be15e34242b029fb341f4311b8">
        <documentation>Ley 2294 de 2023 y Decreto 2236 de 2023; regulacion CREG.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Captacion de clientes y medidores" id="id-1d85ebef43814b5182141bf3f4f22638">
        <documentation>De 0 a 2.000.000 de medidores en 24 meses; hasta +80.000 altas/mes.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Crecimiento de ingresos" id="id-1fb9fea08dd844509cf59ee487d9b392">
        <documentation>Ingresos creciendo ~12% mensual; USD 180 M anualizados en 36 meses.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Liquidez del mercado P2P" id="id-052592c5e7d746abb1885cb9c1c7c4c8">
        <documentation>Energia transada entre pares creciendo mes a mes, con liquidacion confiable.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Confianza y retencion" id="id-80955302c0b042168836ec4f5be0b62e">
        <documentation>Retencion anual &gt;= 92%; cero incidentes graves de seguridad o de facturacion.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Expansion regional" id="id-da2c79200c0f4a498445d4a131b61ac9">
        <documentation>Cuatro paises (Colombia, Chile, Mexico, Brasil) sobre la misma plataforma.</documentation>
      </element>
    </folder>
    <folder name="Assessments" id="id-74a9526f636746d08913c2edee1aa9ea">
      <element xsi:type="archimate:Assessment" name="Riesgo de infraestructura critica" id="id-753dc3c675644ff9b1e7d076ba7f9eaa">
        <documentation>Un fallo puede dejar a una comunidad sin energia, enviar un comando peligroso a una bateria o corromper la liquidacion de un mercado.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Tension de los seis atributos de calidad" id="id-99604d0a24ea4aa2895d1b3229d8d0b8">
        <documentation>El caso insignia (comunidades + P2P + certificados) tensiona latencia, escalabilidad, disponibilidad, seguridad, modificabilidad e integrabilidad a la vez.</documentation>
      </element>
    </folder>
    <folder name="Goals" id="id-3fee6d8156434c6b890ac0fb136e71f6">
      <element xsi:type="archimate:Goal" name="2.000.000 de medidores conectados en 24 meses" id="id-875c28ceda294143a34c0efbb9fe141a">
        <documentation>Meta de captacion: hasta +80.000 altas/mes.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="USD 180 M de ingresos anualizados en 36 meses" id="id-be37bb625465467db3f91894b330e9a7">
        <documentation>Meta de crecimiento de ingresos.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Crecimiento de ingresos ~12% mensual" id="id-09e7bbde894d4e9797f99315d3d683f0">
        <documentation>Ritmo de crecimiento sostenido de ingresos.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="500 comunidades energeticas activas" id="id-557f8292faf04d8eace1d37f0dae8c41">
        <documentation>500 comunidades activas en 24 meses, con reglas de reparto propias.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Retencion anual &gt;= 92%" id="id-8537e2bce02a421c813ec7f836196466">
        <documentation>Confianza del cliente; cero incidentes graves de seguridad o facturacion.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Mercado P2P liquido en cuatro paises" id="id-0ab0068958d24c1bad24be94f5f1c078">
        <documentation>Expansion regional con liquidacion confiable entre pares.</documentation>
      </element>
    </folder>
    <folder name="Outcomes y Value" id="id-6e4b859917d54694b12d87fc692c6c1e">
      <element xsi:type="archimate:Outcome" name="Plataforma de datos, control y liquidacion en tiempo real" id="id-f55c462f0751435e85a369ca06b125cd">
        <documentation>Cualquier hogar o empresa puede producir, consumir, almacenar y vender energia de forma simple, transparente y en tiempo real.</documentation>
      </element>
      <element xsi:type="archimate:Value" name="Visibilidad, tarifas dinamicas, P2P y certificados verificables" id="id-0e00303e3e50401fb14a66811326e814">
        <documentation>Propuesta de valor: visibilidad del consumo en tiempo real, tarifas dinamicas, venta de excedentes al vecino y certificados de origen renovable verificables.</documentation>
      </element>
    </folder>
    <folder name="Principles" id="id-ab83bc364c684bb685036342c09b488f">
      <element xsi:type="archimate:Principle" name="Zero Trust" id="id-aea38debc3c343c3bd9022a3ca1ec4b7">
        <documentation>Nunca confiar, siempre verificar: identidad fuerte por dispositivo/servicio, minimo privilegio, microsegmentacion, separacion TI/OT y verificacion continua. Eje transversal por infraestructura critica.</documentation>
      </element>
    </folder>
    <folder name="Requirements" id="id-54f58641a01040dcac56d709278ef1d4">
      <folder name="Funcionales" id="id-8cd629405ace4e39b6d409c0fb84b775">
        <element xsi:type="archimate:Requirement" name="Telemetria y visibilidad en tiempo real" id="id-3a8329e35873495b863ec68c3035f2e6">
          <documentation>El medidor reporta consumo y generacion; el dato se valida, se almacena y el prosumidor lo ve en su app casi al instante.</documentation>
        </element>
        <element xsi:type="archimate:Requirement" name="Facturacion y liquidacion" id="id-155a5bb9f06644ae8706d633f321aa31">
          <documentation>Consumo neto, tarifa (posiblemente dinamica), valoracion de excedentes y emision de factura.</documentation>
        </element>
        <element xsi:type="archimate:Requirement" name="Mercado P2P de energia" id="id-4f5ebb175e0d41e3b753d7b3cc689b46">
          <documentation>Emparejamiento de ofertas y demandas entre vecinos y liquidacion de cada transaccion.</documentation>
        </element>
        <element xsi:type="archimate:Requirement" name="Certificados de origen renovable" id="id-e4bd7182f8ef4b9cbe90581e0c60bc21">
          <documentation>Certificado verificable, transferible y no duplicable por la energia limpia generada.</documentation>
        </element>
        <element xsi:type="archimate:Requirement" name="Respuesta a la demanda" id="id-c97e4d5bfdb0458c82f26a30b540d266">
          <documentation>Comandos a baterias y dispositivos ante picos o senales de precio; compensacion por flexibilidad.</documentation>
        </element>
        <element xsi:type="archimate:Requirement" name="Comunidad energetica" id="id-724be406b064447d97f6220a6d75e6c9">
          <documentation>Alta y operacion de comunidad con reglas configurables de reparto de energia y excedentes.</documentation>
        </element>
        <element xsi:type="archimate:Requirement" name="Cliente web de operacion y gestion" id="id-b116432e17564f0ca9c676083a58c247">
          <documentation>Experiencia completa: mesa de energia, facturacion, administracion de comunidades, tableros regulatorios y back-office.</documentation>
        </element>
        <element xsi:type="archimate:Requirement" name="Cliente movil del prosumidor" id="id-a505b786554a4906955cfd9774180541">
          <documentation>Monitoreo en tiempo real, push, control de dispositivos, biometria, reporte de incidencias y modo offline.</documentation>
        </element>
      </folder>
      <folder name="Atributos de calidad" id="id-3d78e76bfda743dc8fe20f1a398294e6">
        <element xsi:type="archimate:Requirement" name="Latencia" id="id-06fcb40759914413981eda2f6f066e10">
          <documentation>Telemetria a app p95 &lt;= 500 ms; comando demanda p95 &lt;= 1 s; emparejamiento P2P p95 &lt;= 300 ms; consulta p95 &lt;= 200 ms.</documentation>
        </element>
        <element xsi:type="archimate:Requirement" name="Escalabilidad" id="id-2f69a55b4bd94facab7b60f8897f090f">
          <documentation>2M medidores cada 15 min (&gt;= 2.200 lecturas/s); picos 10x; liquidar 2M cuentas en &lt; 4 h; alta de pais &lt;= 6 semanas.</documentation>
        </element>
        <element xsi:type="archimate:Requirement" name="Disponibilidad" id="id-801bad3d73ef4024a4c867920a2b744b">
          <documentation>&gt;= 99,99% mensual; fail-safe en dispositivos; RTO zona &lt;= 5 min / RPO &lt;= 10 s; failover multi-region RTO &lt;= 10 min.</documentation>
        </element>
        <element xsi:type="archimate:Requirement" name="Seguridad" id="id-9d19812ac0be47e59e436ca475009abc">
          <documentation>Comandos autenticados/firmados/no repudiables; identidad IoT con revocacion &lt;= 5 min; cifrado, antifraude de medicion; certificados no duplicables; liquidacion 100% reconstruible; CREG, Ley 1581, PCI-DSS.</documentation>
        </element>
        <element xsi:type="archimate:Requirement" name="Facilidad de modificacion" id="id-cd77f6fa1180430d88fc49bbc9d4133a">
          <documentation>Nueva tarifa &lt;= 2 semanas-equipo; cambios CREG localizados; reglas de comunidad configurables sin codigo; nuevos DER sin tocar el motor de control.</documentation>
        </element>
        <element xsi:type="archimate:Requirement" name="Facilidad de integracion" id="id-24e601ddc99a4895a0216c1a23e9b7dc">
          <documentation>Nuevo fabricante &lt;= 2 semanas via adaptador; APIs versionadas web/movil; estandares del sector; contratos claros para agregadores.</documentation>
        </element>
      </folder>
    </folder>
    <folder name="Constraints" id="id-c2909a13cedb46a7bf6b2fc7b00146f2">
      <element xsi:type="archimate:Constraint" name="Diseno incremental con PoC por modulo" id="id-528398fce3934063b2e63f3c71c05478">
        <documentation>Cada modulo culmina en una PoC que valida una parte de la arquitectura sobre el caso.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Estilos de nueva generacion" id="id-e93f64c9375b45dcb24e9c9f58113bf6">
        <documentation>Incorporar microservicios y APIs, EDA, blockchain e IA generativa/agentica donde aporten valor real.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Cloud-native y contenedores" id="id-e23ead5deb254a6180870492fa491cc4">
        <documentation>Empaquetado en contenedores y despliegue en la nube con automatizacion reproducible.</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Operacion sobre infraestructura critica" id="id-e86c5594ae7d47948eb4d8da0c9266e6">
        <documentation>Seguridad y disponibilidad no negociables; estado seguro ante fallo (fail-safe).</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Proyecto semestral en equipo multidisciplinario" id="id-51fc6f5bcdf243da8ab9af458c61c573">
        <documentation>Equipos de 4-5 personas con entregas incrementales (cuadernos de trabajo).</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Crecimiento regional sostenible" id="id-ad4292fc28f240c998ca3a25a1820235">
        <documentation>Soportar metas de ingresos y medidores sin redisenos disruptivos.</documentation>
      </element>
    </folder>
  </folder>
